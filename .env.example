# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit your actual credentials.

# --- Required: Jira ---
# Used by scripts/jira_bridge.py and the Discord daemon. The MCP servers do NOT
# read this file -- they resolve credentials through the registry (see the
# Drunken-Guild Guide, section 3.3).
JIRA_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="your-email@example.com"
# JIRA_TOKEN is read first, JIRA_API_TOKEN second. Set either one.
JIRA_TOKEN="your-jira-api-token"
JIRA_PROJECT_KEY="DG"

# --- Required: Discord ---
# Create a bot at https://discord.com/developers/applications, invite it to
# your server, and enable the Message Content + Server Members intents.
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_CHANNEL_ID="123456789012345678"

# --- Optional ---
# A separate GitHub token used only when Discord dispatches an agent
# subprocess (e.g. /approve), kept distinct from your own `gh` auth.
# GITHUB_MINABOT="your-github-bot-token"

# No longer read by anything here. scripts/create_pr.py was retired in DG-274;
# `gh pr create` is what opens pull requests, and it carries its own auth.
# GITHUB_PERSONAL_ACCESS_TOKEN="your-github-personal-access-token"

# Lets a failed dispatched-agent task explain why it failed. Safe to leave
# unset -- that feature just falls back to no explanation.
# GEMINI_API_KEY="your-gemini-api-key"

# Only needed if you're syncing docs to Confluence (scripts/confluence_bridge.py).
# Defaults to JIRA_EMAIL if unset.
# CONFLUENCE_EMAIL="your-email@example.com"

# How long the Discord approval flow waits before reminding/escalating.
# Defaults shown below.
# APPROVAL_TIMEOUT_SECONDS="900"
# APPROVAL_SOCKET_TIMEOUT_SECONDS="2400"
