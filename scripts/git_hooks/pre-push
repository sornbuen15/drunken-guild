#!/bin/sh
# drunken-guild native pre-push hook (DG-479/DG-480) -- do not edit by hand.
#
# Installed by `drunken-init --install-git-hooks` (src/core/git_hooks.py).
# Removing or editing this file removes the push-time privacy scan
# entirely; `drunken-doctor`'s guard.git_hooks reports that gap and names
# the install command that restores it.
#
# WHY NATIVE: pre-commit's own pre-push stage does not run for every push
# (DG-479) -- pre_commit.commands.hook_impl._pre_push_ns reports "nothing
# to push", and the hook process is never started at all, whenever every
# pushed ref either deletes something or already points at a commit
# reachable from a remote-tracking ref. A solo annotated tag pushed onto an
# already-public commit (`git push origin v1`) and a push that is only ref
# deletions both hit this; the tag's own message then reaches the remote
# completely unscanned. git itself has no such gap: a *native* pre-push
# hook -- this file, not managed by pre-commit -- is invoked for every
# push git performs, reading the ref lines directly off its own stdin
# rather than through pre-commit's filtering. That is also why pre-commit's
# pre-push stage is not installed alongside this one (see
# .pre-commit-config.yaml): two hooks racing to own the same stage is what
# DG-479's decision record rules out.
#
# This also closes DG-480 (a brand-new repository's first push being
# refused) for free: pre-commit's own "all_files" path for a from-scratch
# push leaves both FROM and TO unset, which check_operator_inventory.py
# correctly refuses rather than guess. This hook never hits that path at
# all -- git always hands it the real local/remote sha for every ref line,
# including a first push (remote sha all-zero), so there is always a real
# TO to scan.
#
# Arguments: $1 remote name, $2 remote URL -- both unused and never
# printed: a remote URL can carry a credential or a token.
# Stdin: one line per ref this push would update:
#   <local ref> SP <local sha> SP <remote ref> SP <remote sha> LF
#
# The scanner is invoked exactly ONCE per push, not once per ref line
# (round 2 review): check_operator_inventory.py --push already unions its
# ref-specific range with a global scan of every commit and tag
# unpublished on ANY local branch or tag (DG-468 round 2), so a second or
# third ref line adds nothing a single invocation would not already see --
# calling it once per ref made a 500-ref push take over six minutes
# instead of a few seconds. The one ref line actually passed as
# PRE_COMMIT_TO_REF/FROM_REF is the first non-deletion line, exactly the
# line pre-commit's own pre-push wrapper used to report (see
# check_operator_inventory.py's module docstring) -- this hook's whole
# reason to exist is that git invokes it when pre-commit's wrapper would
# not, not a change to which single ref is treated as "the" ref.
#
# Fails closed: a missing python interpreter, a missing scanner script, or
# an unresolvable repository root all refuse the push with a message,
# never silently let it through -- the same rule
# check_operator_inventory.py itself already follows for every other
# unresolvable case.

find_python() {
    for candidate in python3 python py; do
        if command -v "$candidate" >/dev/null 2>&1; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

PYTHON=$(find_python) || {
    echo "drunken-guild pre-push: no python interpreter (python3/python/py) found on PATH. Refusing the push rather than skipping the privacy scan." >&2
    exit 1
}

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "drunken-guild pre-push: could not resolve the repository root. Refusing the push." >&2
    exit 1
}

SCRIPT="$REPO_ROOT/scripts/check_operator_inventory.py"
if [ ! -f "$SCRIPT" ]; then
    echo "drunken-guild pre-push: $SCRIPT not found. Refusing the push rather than skipping the privacy scan." >&2
    exit 1
fi

zero_sha="0000000000000000000000000000000000000000"
to_ref=""
from_ref=""
lines_seen=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_ref" ] && continue
    lines_seen=$((lines_seen + 1))
    if [ -z "$to_ref" ] && [ "$local_sha" != "$zero_sha" ]; then
        to_ref="$local_sha"
        from_ref="$remote_sha"
    fi
done

# git always writes at least one line per ref it is about to update; zero
# lines read means something ran this hook in a shape git itself never
# produces (invoked by hand with no input, or a caller that swallowed
# stdin) -- refused rather than read as "nothing to scan", the same rule
# every other unresolvable case in check_operator_inventory.py follows.
if [ "$lines_seen" -eq 0 ]; then
    echo "drunken-guild pre-push: no ref lines on stdin. Refusing rather than treating this as nothing to scan." >&2
    exit 1
fi

# Every line was a deletion: nothing of its own to scan a ref-specific
# range for, but the always-on global scan below still needs to run once.
if [ -z "$to_ref" ]; then
    to_ref="$zero_sha"
fi

PRE_COMMIT_TO_REF="$to_ref" PRE_COMMIT_FROM_REF="$from_ref" "$PYTHON" "$SCRIPT" --push
