{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(uv run pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format --check:*)",
      "Bash(mypy:*)",
      "Bash(bandit:*)",
      "Bash(pip-audit:*)",
      "Bash(gitleaks detect:*)",
      "Bash(uv run drunken-doctor:*)",
      "Bash(uv run drunken-usage:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run mypy:*)",
      "Bash(uvx bandit:*)",
      "Bash(git fetch:*)",
      "Bash(./scripts/verify_clean_install.sh)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(python scripts/*)",
      "Bash(./scripts/*.sh)",
      "Bash(uv run drunken-away:*)",
      "Read(./**/*)",
      "Edit(./**/*)",
      "find_by_name(./**/*)",
      "grep_search(./**/*)",
      "list_dir(./**/*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --directory \"${CLAUDE_PROJECT_DIR:-.}\" drunken-hook",
            "timeout": 30,
            "statusMessage": "Checking the deny floor\u2026"
          }
        ]
      }
    ]
  }
}
